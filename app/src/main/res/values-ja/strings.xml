    <!-- Privacy options -->
    <string name="opt_prevent_mark_as_read_label">プラスメニューに「既読回避」を追加</string>
    <string name="opt_prevent_mark_as_read_desc">トークタブ右上の「+」メニューから既読回避をON/OFFできるようになります。ONにすると「送信後既読」オプションも表示されます。</string>
    <string name="opt_record_read_history_label">既読履歴を記録</string>
    <string name="opt_record_read_history_desc">誰がいつメッセージを既読にしたかを記録します。チャット画面上部の本アイコンから確認できます。</string>
    <string name="opt_prevent_unsend_message_label">送信取り消し無効化</string>
    <string name="opt_prevent_unsend_message_desc">相手がメッセージの送信を取り消しても、自分の端末には残るようにします。取り消されたメッセージにはアイコンが表示され、タップすることで取消日時を確認できます。</string>
    <string name="opt_show_profile_timestamps_label">プロフィールに詳細情報を表示</string>
    <string name="opt_show_profile_timestamps_desc">友だちのプロフィール画面の右上にⓘアイコンを追加します。タップすると、MID・友だち追加・お気に入り登録・プロフィール更新の日時をダイアログで表示します。記録がない項目は「—」と表示されます。</string>
    <string name="profile_ts_friend_created">友だち追加</string>
    <string name="profile_ts_favorite">お気に入り</string>
    <string name="profile_ts_profile_updated">プロフ更新</string>
    <string name="profile_ts_dialog_title">プロフィール情報</string>
    <string name="profile_ts_copy_mid">MIDをコピー</string>
    <string name="profile_ts_mid_copied">MIDをコピーしました</string>
    <!-- Chat options -->
    <string name="opt_high_quality_photo_label">写真の送信品質を向上</string>
    <string name="opt_high_quality_photo_desc">写真送信時の自動圧縮・リサイズを回避し、最高品質で送信できるようにします。設定の「高画質」よりもさらに高品質な送信が可能になります。</string>
    <string name="opt_long_video_label">5分以上の動画を送信可能にする</string>
    <string name="opt_long_video_desc">動画送信時の5分の時間制限を解除し、長い動画を送信できるようにします。</string>
    <string name="opt_enable_mute_message_label">ミュートメッセージを有効化</string>
    <string name="opt_enable_mute_message_desc">LINEラボから削除されたミュートメッセージ機能を有効化します。</string>
    <string name="opt_use_default_camera_label">標準カメラを使用</string>
    <string name="opt_use_default_camera_desc">LINE内蔵カメラの代わりに端末の標準カメラアプリを使用します。</string>
    <string name="opt_mute_camera_shutter_label">LINE内蔵カメラを無音化</string>
    <string name="opt_mute_camera_shutter_desc">LINE内蔵カメラのシャッター音を無音にします。標準カメラ使用時は無効です。</string>
    <string name="opt_search_by_member_label">メンバーでトーク内検索</string>
    <string name="opt_search_by_member_desc">検索ボックス内の虫眼鏡アイコンを押すことで、メンバーを選んでそのユーザーのメッセージのみを絞り込み検索できるようにします。</string>
    <string name="opt_search_min_1_char_label">1文字からトーク内検索</string>
    <string name="opt_search_min_1_char_desc">トーク内検索の最低文字数を2文字から1文字に緩和します。</string>
    <string name="opt_show_seconds_in_chat_time_label">チャットの時刻に秒を表示</string>
    <string name="opt_show_seconds_in_chat_time_desc">各メッセージ横の時刻表示に秒を追加します。 (例: 12:34 → 12:34:56)</string>
    <string name="opt_select_all_in_edit_mode_label">メッセージ削除画面に全選択ボタンを追加</string>
    <string name="opt_select_all_in_edit_mode_desc">メッセージ削除画面の下部に、すべてのメッセージを選択・選択解除できるボタンを追加します。</string>
    <string name="opt_show_edit_history_label">メッセージ編集履歴を記録</string>
    <string name="opt_show_edit_history_desc">メッセージが編集されたときに編集前のテキストを記録し、編集済みメッセージの長押しメニューに「編集履歴」を追加します。</string>
    <string name="edit_history_title">編集履歴</string>
    <string name="edit_history_empty">編集履歴はありません。</string>
    <string name="edit_history_original">元のメッセージ</string>
    <string name="edit_history_edited">編集</string>
    <string name="edit_history_delete_confirm_msg">このメッセージの編集履歴を削除しますか？</string>
    <string name="opt_fix_announcement_name_label">アナウンス者名の表示を修正</string>
    <string name="opt_fix_announcement_name_desc">パッチ済みのLINEで、アナウンス登録時のシステムメッセージが「がアナウンスしました」と名前が空になる不具合を修正し、正しく表示されるようにします。</string>
    <string name="opt_hide_ai_icon_permanently_label">トークルームのAgent iを永久に非表示</string>
    <string name="opt_hide_ai_icon_permanently_desc">トークルームのメッセージ入力欄に表示されるAgent iを常に非表示にします。通常は30日間のみ非表示にできますが、このオプションを有効にすると設定に関わらず永続的に非表示になります。</string>
    <string name="opt_open_url_in_default_browser_label">URLをデフォルトブラウザで開く</string>
    <string name="opt_open_url_in_default_browser_desc">URLをアプリ内ブラウザではなく、システムのデフォルトブラウザで開くようにします。</string>
    <!-- Appearance options -->
    <string name="opt_remove_ads_label">広告を非表示</string>
    <string name="opt_remove_ads_desc">トークリスト上部やホーム画面などに表示される広告を非表示にします。</string>
    <string name="opt_remove_home_recommendations_label">ホームのおすすめ/フィードを非表示</string>
    <string name="opt_remove_home_recommendations_desc">ホーム画面（HOME26を含む）に表示されるおすすめコンテンツやフィードを非表示にします。</string>
    <string name="opt_remove_home_services_label">ホームのサービス一覧を非表示</string>
    <string name="opt_remove_home_services_desc">ホーム画面に表示されるサービス一覧を非表示にします。</string>
    <string name="opt_remove_home_accordion_label">ホーム上部のアコーディオンを非表示</string>
    <string name="opt_remove_home_accordion_desc">ホームタブ上部（検索バーと友達リストの間）に表示されるLYP特典などのアコーディオン枠を非表示にします。</string>
    <string name="opt_remove_tab_voom_label">VOOMタブを非表示</string>
    <string name="opt_remove_tab_voom_desc">下部のVOOMタブを隠します。</string>
    <string name="opt_remove_tab_news_label">ニュース/通話タブを非表示</string>
    <string name="opt_remove_tab_news_desc">下部のニュース/通話タブを隠します。</string>
    <string name="opt_remove_tab_mini_label">アプリタブを非表示</string>
    <string name="opt_remove_tab_mini_desc">下部のアプリタブを隠します。</string>
    <string name="opt_remove_tab_commerce_label">ショッピングタブを非表示</string>
    <string name="opt_remove_tab_commerce_desc">下部のショッピングタブを隠します。</string>
    <string name="opt_remove_tab_wallet_label">ウォレットタブを非表示</string>
    <string name="opt_remove_tab_wallet_desc">下部のウォレットタブを隠します。</string>
    <string name="opt_extend_tab_click_area_label">タブのタップ範囲を拡張</string>
    <string name="opt_extend_tab_click_area_desc">下部タブの反応範囲を広げ、押しやすくします。</string>
    <string name="opt_hide_tab_text_label">タブラベルを非表示</string>
    <string name="opt_hide_tab_text_desc">下部タブのアイコン下のテキストを非表示にします。</string>
    <string name="opt_home_tab_type_label">ホームの種類を変更</string>
    <string name="opt_home_tab_type_desc">ホームタブの種類を変更します。従来のホームに戻す場合は\"HOME\"を選択してください。</string>
    <string name="home_type_default">デフォルト</string>
    <string name="opt_remove_ai_friends_button_label">AI Friendsボタンを非表示</string>
    <string name="opt_remove_ai_friends_button_desc">トークタブ右上の「AI Friends」ボタンを非表示にします。</string>
    <string name="opt_remove_search_bar_agent_i_button_label">Agent i関連のボタンを非表示</string>
    <string name="opt_remove_search_bar_agent_i_button_desc">各タブの「Agent i」ボタンと、トークルーム内の「+」メニューにある「トークルームのAgent iを表示」トグルをまとめて非表示にします。</string>
    <string name="opt_remove_open_chat_button_label">オープンチャットボタンを非表示</string>
    <string name="opt_remove_open_chat_button_desc">トークタブ右上の「オープンチャット」ボタンを非表示にします。</string>
    <string name="opt_remove_calendar_button_label">カレンダーボタンを非表示</string>
    <string name="opt_remove_calendar_button_desc">トークタブ右上の「カレンダー」ボタンを非表示にします。</string>
    <string name="opt_remove_album_button_label">アルバムボタンを非表示(サブ端末用)</string>
    <string name="opt_remove_album_button_desc">サブ端末のトークタブ右上に表示される「アルバム」ボタンを非表示にします。</string>
    <string name="opt_use_custom_font_label">カスタムフォントを有効にする</string>
    <string name="opt_use_custom_font_desc">選択したフォントファイルをアプリ全体に適用します。反映にはアプリの再起動が必要です。</string>
    <string name="opt_custom_font_path_label">フォントファイルを選択</string>
    <string name="opt_custom_font_path_desc">使用するフォントファイル (.ttf / .otf) を選択します。</string>
    <string name="opt_use_amoled_theme_label">AMOLEDテーマを適用する</string>
    <string name="opt_use_amoled_theme_desc">AMOLEDテーマを適用します。\"ダークモードでは「ブラック」着せかえを適用\"をオフにする必要があります。メニューやダイアログもAMOLEDの配色に揃えます。</string>
    <string name="opt_force_dark_mode_ui_label">着せかえ適用中もダークモードUIを維持</string>
    <string name="opt_force_dark_mode_ui_desc">着せかえ適用時にライト表示になる長押しメニューやダイアログを、\"ダークモードでは「ブラック」着せかえを適用\"設定に関わらずダークに固定します。「AMOLEDテーマを適用する」有効時はそちらに含まれるため無効です。</string>
    <string name="opt_show_theme_on_sub_device_label">サブ端末で着せかえ項目を表示</string>
    <string name="opt_show_theme_on_sub_device_desc">サブ端末でログインした際、公式設定で非表示になる「着せかえ」項目を表示します。※着せかえショップは開けません。購入はメイン端末で行ってください。</string>
    <!-- Notification options -->
    <string name="opt_reaction_notification_label">リアクション通知</string>
    <string name="opt_reaction_notification_desc">メッセージについたリアクションを通知します。※アプリを開くと送信されます。フォアグラウンドサービス化している場合、LINEを起動していなくても通知が届きます。</string>
    <string name="opt_stack_message_notifications_label">通知を上書きしない</string>
    <string name="opt_stack_message_notifications_desc">通知を上書きせず、最大7件まで一つの通知の中にまとめて表示します。</string>
    <string name="opt_remove_notification_mute_button_label">「通知をオフ」ボタンを非表示</string>
    <string name="opt_remove_notification_mute_button_desc">LINEの通知に表示される「通知をオフ」ボタンを削除します。</string>
    <string name="opt_fix_settings_talk_crash_label">トーク設定のクラッシュを修正</string>
    <string name="opt_fix_settings_talk_crash_desc">パッチ済みのLINEで、公式設定の「トーク」を開くとクラッシュする問題を修正します。</string>
    <string name="opt_experimental_fcm_fix_desc">非root環境で通知が1分程度で届かなくなる問題を回避するため、LINEのFCM通知受信処理を直接サービスに引き渡す挙動を有効にします。</string>
    <string name="opt_fcm_fix_mode_desc">FCM Fixの動作モードを選択します。従来（Legy維持）はLINE独自のストリーミング接続を維持して通知を届けます。FIS（証明書偽装）はFCMトークン発行時の署名を公式証明書に偽装します。</string>
    <string name="fcm_fix_mode_legy">従来（Legy維持）</string>
    <string name="fcm_fix_mode_fis">FIS（証明書偽装）</string>
    <string name="opt_fcm_force_registration_label">FCMトークンを再登録</string>
    <string name="opt_fcm_force_registration_desc">通知が届かない場合に、LINEのFCMトークンを再取得します。</string>
    <string name="fcm_force_registration_needs_fix">先にFCM Fixを有効にしてください</string>
    <string name="fcm_force_registration_started">FCMトークンの再登録を開始しました</string>
    <string name="fcm_force_registration_failed">FCMトークンの再登録を開始できませんでした</string>
    <string name="opt_line_foreground_keep_alive_label">LINEを常にフォアグラウンドサービス化する</string>
    <string name="opt_line_foreground_keep_alive_desc">バッテリー使用量が増加する可能性がありますが、FCMFixがタスクキル後も動作します。非root環境で通知が届かなくなる問題の回避に有効です。Knotアップデート時は強制停止か一時停止が必要になる場合があります。</string>
    <!-- System options -->
    <string name="opt_spoof_version_unsend_only_label">送信取り消しの時間制限を延長</string>
    <string name="opt_spoof_version_unsend_only_desc">送信取り消し時のみバージョンを15.12.2に偽装し、1時間の時間制限を24時間に戻します。</string>
    <string name="opt_spoof_version_label">アプリバージョンの偽装 (常時)</string>
    <string name="opt_spoof_version_desc">常にアプリバージョンを15.12.2に偽装します。なにか特別な目的がない限り使用しないでください。</string>
    <string name="opt_fix_signature_mismatch_label">公式署名を偽装</string>
    <string name="opt_fix_signature_mismatch_desc">パッチ済みのLINEで、フォントのダウンロードや生体認証の連携などに失敗する問題を回避します。</string>
    <!-- Storage / backup rows -->
    <string name="desc_path_row">モジュールの設定ファイルなどが保存されるディレクトリを選択します。</string>
    <string name="desc_reset_row">すべてのモジュール設定をデフォルト状態に戻します。</string>
    <string name="opt_backup_label">トーク履歴のバックアップ</string>
    <string name="opt_backup_desc">現在のトーク履歴を保存先にバックアップします。</string>
    <string name="opt_restore_label">トーク履歴の復元</string>
    <string name="opt_restore_desc">バックアップファイルからトーク履歴を復元します。現在の履歴が上書きされます。</string>
